      "source": [
        "# Participação percentual das causas no total de mortes de 2021–2025.\n",
        "con.execute(\"\"\"\n",
        "    WITH causas AS (\n",
        "        SELECT\n",
        "            causa_acidente,\n",
        "            SUM(COALESCE(mortos, 0)) AS total_mortes,\n",
        "            COUNT(*) AS total_acidentes\n",
        "        FROM acidentes\n",
        "        WHERE ano BETWEEN 2021 AND 2025\n",
        "          AND causa_acidente IS NOT NULL\n",
        "        GROUP BY causa_acidente\n",
        "    )\n",
        "    SELECT\n",
        "        causa_acidente,\n",
        "        total_mortes,\n",
        "        total_acidentes,\n",
        "        ROUND(\n",
        "            total_mortes * 100.0 / NULLIF(SUM(total_mortes) OVER (), 0),\n",
        "            2\n",
        "        ) AS percentual_mortes\n",
        "    FROM causas\n",
        "    ORDER BY total_mortes DESC\n",
        "    LIMIT 10\n",
        "\"\"\").df()"
      ]
    },
