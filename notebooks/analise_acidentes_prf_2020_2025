      "source": [
        "# Variação percentual de mortes entre 2021 e 2025 para as causas selecionadas.\n",
        "con.execute(\"\"\"\n",
        "    WITH resumo AS (\n",
        "        SELECT\n",
        "            causa_acidente,\n",
        "            SUM(CASE WHEN ano = 2021 THEN COALESCE(mortos, 0) ELSE 0 END) AS mortes_2021,\n",
        "            SUM(CASE WHEN ano = 2025 THEN COALESCE(mortos, 0) ELSE 0 END) AS mortes_2025\n",
        "        FROM acidentes\n",
        "        WHERE ano BETWEEN 2021 AND 2025\n",
        "          AND causa_acidente IN (\n",
        "              'Transitar na contramão',\n",
        "              'Velocidade Incompatível',\n",
        "              'Ausência de reação do condutor'\n",
        "          )\n",
        "        GROUP BY causa_acidente\n",
        "    )\n",
        "    SELECT\n",
        "        causa_acidente,\n",
        "        mortes_2021,\n",
        "        mortes_2025,\n",
        "        ROUND(\n",
        "            (mortes_2025 - mortes_2021) * 100.0 / NULLIF(mortes_2021, 0),\n",
        "            2\n",
        "        ) AS variacao_percentual\n",
        "    FROM resumo\n",
        "    ORDER BY variacao_percentual DESC\n",
        "\"\"\").df()"
      ]
    },
