        "pasta_saida = \"/content/drive/MyDrive/analise-acidentes-prf/processed\"\n",
        "os.makedirs(pasta_saida, exist_ok=True)\n",
        "\n",
        "evolucao_anual = con.execute(\"\"\"\n",
        "    SELECT\n",
        "        ano,\n",
        "        COUNT(*) AS total_acidentes,\n",
        "        SUM(COALESCE(mortos, 0)) AS total_mortes\n",
        "    FROM acidentes\n",
        "    GROUP BY ano\n",
        "    ORDER BY ano\n",
        "\"\"\").df()\n",
        "\n",
        "principais_causas = con.execute(\"\"\"\n",
        "    SELECT\n",
        "        causa_acidente,\n",
        "        COUNT(*) AS total_acidentes,\n",
        "        SUM(COALESCE(mortos, 0)) AS total_mortes\n",
        "    FROM acidentes\n",
        "    WHERE ano BETWEEN 2021 AND 2025\n",
        "      AND causa_acidente IS NOT NULL\n",
        "    GROUP BY causa_acidente\n",
        "    ORDER BY total_mortes DESC\n",
        "\"\"\").df()\n",
        "\n",
        "acidentes_fatais_uf = con.execute(\"\"\"\n",
        "    SELECT\n",
        "        uf,\n",
        "        COUNT(*) AS acidentes_fatais\n",
        "    FROM acidentes\n",
        "    WHERE classificacao_acidente = 'Com Vítimas Fatais'\n",
        "      AND uf IS NOT NULL\n",
        "    GROUP BY uf\n",
        "    ORDER BY acidentes_fatais DESC\n",
        "\"\"\").df()\n",
        "\n",
        "evolucao_causas = con.execute(\"\"\"\n",
        "    SELECT\n",
        "        ano,\n",
        "        causa_acidente,\n",
        "        COUNT(*) AS total_acidentes,\n",
        "        SUM(COALESCE(mortos, 0)) AS total_mortes\n",
        "    FROM acidentes\n",
        "    WHERE ano BETWEEN 2021 AND 2025\n",
        "      AND causa_acidente IN (\n",
        "          'Ausência de reação do condutor',\n",
        "          'Transitar na contramão',\n",
        "          'Velocidade Incompatível'\n",
        "      )\n",
        "    GROUP BY ano, causa_acidente\n",
        "    ORDER BY ano, causa_acidente\n",
        "\"\"\").df()\n",
        "\n",
        "tabelas_exportacao = {\n",
        "    \"evolucao_anual.csv\": evolucao_anual,\n",
        "    \"principais_causas.csv\": principais_causas,\n",
        "    \"acidentes_fatais_uf.csv\": acidentes_fatais_uf,\n",
        "    \"evolucao_causas.csv\": evolucao_causas,\n",
        "}\n",
        "\n",
        "for nome_arquivo, tabela in tabelas_exportacao.items():\n",
